# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

COPY go.mod ./
# Copy go.sum if it exists
COPY go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o processor-service ./cmd/processor-service/main.go

# Final stage
FROM alpine:latest

WORKDIR /app

# Copy binary from build stage
COPY --from=builder /app/processor-service .

# Expose port
EXPOSE 8082

# Run the service
CMD ["./processor-service"]
