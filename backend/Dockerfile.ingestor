FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go module files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o /ingestor-service ./cmd/ingestor-service

# Create final lightweight image
FROM alpine:3.18

WORKDIR /app

# Install CA certificates
RUN apk --no-cache add ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /ingestor-service .

# Copy certificates if they exist
COPY --from=builder /app/certs /app/certs

# Create a non-root user to run the application
RUN adduser -D -g '' appuser
USER appuser

# Set environment variables
ENV PORT=8081 \
    TLS_CERT_PATH=/app/certs/server.crt \
    ENABLE_PII_ANONYMIZATION=true
# TLS_KEY_PATH should be provided at runtime via environment variables
# rather than being embedded in the image

# Expose the application port
EXPOSE 8081

# Run the application
CMD ["./ingestor-service"]